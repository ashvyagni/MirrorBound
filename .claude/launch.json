{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "apps/server/.venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "mirrorbound.api.app:create_app", "--factory", "--port", "8000"],
      "cwd": "apps/server",
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-attach",
      "url": "http://localhost:5173"
    }
  ]
}
