{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run", "--directory", "apps/server",
        "uvicorn", "mirrorbound.api.app:create_app", "--factory",
        "--host", "127.0.0.1", "--port", "8000", "--reload"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-attach",
      "url": "http://localhost:5173"
    }
  ]
}
