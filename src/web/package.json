{
  "name": "mirrorbound-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "assets": "python3 scripts/build_atlas.py && python3 scripts/build_tiles.py && python3 scripts/build_cursor.py",
    "assets:cursor": "python3 scripts/build_cursor.py",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "^30.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
